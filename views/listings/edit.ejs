<% layout("/layouts/boilerplate") %>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-12 col-lg-9">
      
      <div class="card shadow-lg border-0 rounded-4 p-4 p-md-5">
        
        <div class="text-center mb-4">
          <div class="badge bg-warning-subtle text-warning-emphasis text-uppercase px-3 py-2 rounded-pill fw-bold mb-2">Host Settings</div>
          <h2 class="fw-bold">Edit Listing: <%= listing.title %></h2>
          <p class="text-muted">Update pricing, description, photos, and amenities.</p>
        </div>

        <form action="/listings/<%= listing._id %>?_method=PATCH" method="POST" enctype="multipart/form-data" class="needs-validation" novalidate>
          
          <!-- 1. BASIC INFORMATION -->
          <h5 class="fw-bold mb-3 text-dark border-bottom pb-2">
            <i class="fa-solid fa-hotel text-danger me-2"></i> 1. Basic Details
          </h5>

          <div class="mb-3">
            <label class="form-label fw-semibold">Property Title / Name <span class="text-danger">*</span></label>
            <input type="text" name="listings[title]" class="form-control form-control-lg rounded-3" value="<%= listing.title %>" required minlength="3">
            <div class="invalid-feedback">Please enter a property title.</div>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">Description <span class="text-danger">*</span></label>
            <textarea name="listings[description]" class="form-control rounded-3" rows="4" required minlength="10"><%= listing.description %></textarea>
            <div class="invalid-feedback">Please write a descriptive summary.</div>
          </div>

          <div class="row g-3 mb-4">
            <div class="col-md-6">
              <label class="form-label fw-semibold">Category</label>
              <select name="listings[category]" class="form-select rounded-3">
                <% const categories = ["trending", "beachfront", "villas", "mountains", "pools", "cabins", "iconic", "luxury", "castles", "farms", "camping", "rooms"]; %>
                <% for(let cat of categories) { %>
                  <option value="<%= cat %>" <%= listing.category === cat ? 'selected' : '' %>><%= cat.charAt(0).toUpperCase() + cat.slice(1) %></option>
                <% } %>
              </select>
            </div>

            <div class="col-md-6">
              <label class="form-label fw-semibold">Upload Additional Photos</label>
              <input type="file" name="images" class="form-control rounded-3" multiple accept="image/*">
              <small class="text-muted">New uploads will be appended to your gallery</small>
            </div>
          </div>

          <!-- CURRENT IMAGES PREVIEW -->
          <% if (listing.images && listing.images.length > 0) { %>
            <div class="mb-4">
              <label class="form-label fw-semibold small text-muted">Current Photos Preview</label>
              <div class="d-flex gap-2 overflow-auto py-2">
                <% for(let img of listing.images) { %>
                  <div class="position-relative flex-shrink-0" style="width: 120px; height: 90px;">
                    <img src="<%= img.url %>" class="w-100 h-100 rounded-3 object-fit-cover border shadow-sm">
                  </div>
                <% } %>
              </div>
            </div>
          <% } %>

          <!-- 2. LOCATION & MAP PINPOINT -->
          <h5 class="fw-bold mb-3 text-dark border-bottom pb-2">
            <i class="fa-solid fa-map-location-dot text-danger me-2"></i> 2. Location & Map Pinpoint
          </h5>

          <div class="row g-3 mb-3">
            <div class="col-md-4">
              <label class="form-label fw-semibold">City / Region <span class="text-danger">*</span></label>
              <input type="text" name="listings[location]" id="locationInput" class="form-control rounded-3" value="<%= listing.location %>" required>
            </div>

            <div class="col-md-4">
              <label class="form-label fw-semibold">Country <span class="text-danger">*</span></label>
              <input type="text" name="listings[country]" class="form-control rounded-3" value="<%= listing.country %>" required>
            </div>

            <div class="col-md-4">
              <label class="form-label fw-semibold">Full Address</label>
              <input type="text" name="listings[address]" class="form-control rounded-3" value="<%= listing.address || '' %>">
            </div>
          </div>

          <!-- MAP PINPOINT PICKER -->
          <div class="mb-4">
            <label class="form-label fw-semibold small text-muted">
              <i class="fa-solid fa-crosshairs text-danger me-1"></i> Drag pin or click map to update exact coordinates
            </label>
            <div id="pickerMap" class="rounded-4 border shadow-sm" style="height: 280px;"></div>
            <div class="row g-2 mt-2">
              <div class="col-6">
                <input type="number" step="any" name="lat" id="pickerLat" class="form-control form-control-sm" value="<%= (listing.geometry && listing.geometry.lat) ? listing.geometry.lat : 18.5204 %>" required>
              </div>
              <div class="col-6">
                <input type="number" step="any" name="lng" id="pickerLng" class="form-control form-control-sm" value="<%= (listing.geometry && listing.geometry.lng) ? listing.geometry.lng : 73.8567 %>" required>
              </div>
            </div>
          </div>

          <!-- 3. PRICING & CAPACITY -->
          <h5 class="fw-bold mb-3 text-dark border-bottom pb-2">
            <i class="fa-solid fa-indian-rupee-sign text-danger me-2"></i> 3. Pricing & Capacity
          </h5>

          <div class="row g-3 mb-3">
            <div class="col-md-4">
              <label class="form-label fw-semibold">Price per night (₹) <span class="text-danger">*</span></label>
              <input type="number" name="listings[price]" class="form-control rounded-3" value="<%= listing.price %>" required min="100">
            </div>

            <div class="col-md-4">
              <label class="form-label fw-semibold">Cleaning Fee (₹)</label>
              <input type="number" name="listings[cleaningFee]" class="form-control rounded-3" value="<%= listing.cleaningFee || 499 %>">
            </div>

            <div class="col-md-4">
              <label class="form-label fw-semibold">Service Fee (₹)</label>
              <input type="number" name="listings[serviceFee]" class="form-control rounded-3" value="<%= listing.serviceFee || 299 %>">
            </div>
          </div>

          <div class="row g-3 mb-4">
            <div class="col-3">
              <label class="form-label fw-semibold small">Max Guests</label>
              <input type="number" name="listings[maxGuests]" class="form-control form-control-sm rounded-3" value="<%= listing.maxGuests || 2 %>" min="1">
            </div>
            <div class="col-3">
              <label class="form-label fw-semibold small">Bedrooms</label>
              <input type="number" name="listings[bedrooms]" class="form-control form-control-sm rounded-3" value="<%= listing.bedrooms || 1 %>" min="1">
            </div>
            <div class="col-3">
              <label class="form-label fw-semibold small">Beds</label>
              <input type="number" name="listings[beds]" class="form-control form-control-sm rounded-3" value="<%= listing.beds || 1 %>" min="1">
            </div>
            <div class="col-3">
              <label class="form-label fw-semibold small">Bathrooms</label>
              <input type="number" name="listings[bathrooms]" class="form-control form-control-sm rounded-3" value="<%= listing.bathrooms || 1 %>" min="1">
            </div>
          </div>

          <!-- 4. AMENITIES -->
          <h5 class="fw-bold mb-3 text-dark border-bottom pb-2">
            <i class="fa-solid fa-list-check text-danger me-2"></i> 4. Amenities
          </h5>

          <div class="row g-3 mb-4">
            <% const allAmenities = [
              "Fast Wi-Fi", "Air Conditioning", "Private Swimming Pool", "Free Parking",
              "Kitchen & Utensils", "Dedicated Workspace", "HD TV with Netflix", "Beach Access",
              "Hot Tub / Jacuzzi", "Mountain View", "Balcony / Terrace", "EV Charger",
              "Barbeque Grill", "Washing Machine", "Pet Friendly", "24/7 Security"
            ]; %>
            <% for(let a of allAmenities) { %>
              <% const isChecked = (listing.amenities && listing.amenities.includes(a)); %>
              <div class="col-6 col-md-3">
                <div class="form-check custom-amenity-check p-2 rounded-3 border <%= isChecked ? 'bg-danger-subtle' : '' %>">
                  <input class="form-check-input ms-1" type="checkbox" name="listings[amenities][]" value="<%= a %>" id="amenity_<%= a.replace(/\s+/g, '') %>" <%= isChecked ? 'checked' : '' %>>
                  <label class="form-check-label ms-2 small fw-medium" for="amenity_<%= a.replace(/\s+/g, '') %>"><%= a %></label>
                </div>
              </div>
            <% } %>
          </div>

          <!-- SUBMIT BUTTON -->
          <div class="d-flex justify-content-between align-items-center pt-3 border-top">
            <a href="/listings/<%= listing._id %>" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
            <button type="submit" class="btn btn-warning btn-lg rounded-pill px-5 fw-bold shadow">
              <i class="fa-solid fa-pen-to-square me-2"></i> Save Changes
            </button>
          </div>

        </form>

      </div>

    </div>
  </div>
</div>

<script src="/js/map.js"></script>