<% layout("/layouts/boilerplate") %>

<!-- CATEGORY FILTER BAR + TAX SWITCH -->
<%- include("../includes/categories.ejs") %>

<div class="container-fluid px-3 px-lg-5 py-4">

  <!-- TOP BAR: Results summary & View toggler -->
  <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">
    <div>
      <h4 class="fw-bold mb-1">
        <% if (typeof searchQuery !== 'undefined' && searchQuery) { %>
          Stays in "<%= searchQuery %>"
        <% } else if (typeof currentCategory !== 'undefined' && currentCategory !== 'all') { %>
          <%= currentCategory.charAt(0).toUpperCase() + currentCategory.slice(1) %> Stays
        <% } else { %>
          Explore Luxury Stays Worldwide
        <% } %>
      </h4>
      <p class="text-muted small mb-0">
        Over <%= listing.length %> unique homes, beachfront villas, and scenic escapes available.
      </p>
    </div>

    <!-- FLOATING MAP / LIST VIEW TOGGLE BUTTON -->
    <div class="d-flex gap-2">
      <button class="btn btn-dark rounded-pill px-4 shadow-sm view-toggle-btn" id="toggleMapBtn">
        <i class="fa-solid fa-map me-2"></i> <span id="toggleMapText">Show Map</span>
      </button>
    </div>
  </div>

  <!-- INTERACTIVE LEAFLET MAP VIEW (TOGGLEABLE) -->
  <div id="allListingsMapContainer" class="d-none mb-5">
    <div class="card shadow rounded-4 overflow-hidden border-0">
      <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-3 px-4">
        <span class="fw-bold"><i class="fa-solid fa-earth-americas text-danger me-2"></i> Interactive Global Property Map</span>
        <small class="text-muted">Click any marker to preview property & reserve</small>
      </div>
      <div id="indexMap" style="height: 480px; width: 100%;"></div>
    </div>
  </div>

  <!-- LISTINGS GRID -->
  <% if (listing.length === 0) { %>
    <div class="text-center py-5 empty-state-box my-4">
      <div class="empty-icon mb-3">
        <i class="fa-solid fa-magnifying-glass-location fa-3x text-muted"></i>
      </div>
      <h4 class="fw-bold">No exact matches found</h4>
      <p class="text-muted">Try changing or clearing your search filters to find available properties.</p>
      <a href="/listings" class="btn btn-outline-dark rounded-pill px-4 mt-2">View All Listings</a>
    </div>
  <% } else { %>
    
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4" id="listingsGrid">
      <% for(let item of listing) { %>
        <% 
          const firstImage = (item.images && item.images.length > 0) 
            ? item.images[0].url 
            : 'https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=800&q=80';
          
          let avgRate = "New";
          if (item.reviews && item.reviews.length > 0) {
            let sum = item.reviews.reduce((acc, r) => acc + (r.rating || 5), 0);
            avgRate = (sum / item.reviews.length).toFixed(1);
          }

          const isWishlisted = (userWishlist && userWishlist.includes(item._id.toString()));
          const priceWithTax = Math.round(item.price * 1.18);
        %>

        <div class="col listing-item-card">
          <div class="card h-100 property-card border-0 shadow-sm rounded-4 overflow-hidden position-relative">
            
            <!-- WISHLIST HEART BUTTON -->
            <button class="wishlist-heart-btn <%= isWishlisted ? 'favorited' : '' %>" 
                    data-listing-id="<%= item._id %>"
                    title="<%= isWishlisted ? 'Remove from wishlist' : 'Save to wishlist' %>">
              <i class="<%= isWishlisted ? 'fa-solid fa-heart' : 'fa-regular fa-heart' %>"></i>
            </button>

            <!-- CATEGORY BADGE -->
            <% if (item.category) { %>
              <div class="category-badge position-absolute top-0 start-0 m-3 badge rounded-pill bg-dark bg-opacity-75 text-white text-capitalize">
                <%= item.category %>
              </div>
            <% } %>

            <!-- IMAGE LINK -->
            <a href="/listings/<%= item._id %>" class="property-link">
              <div class="card-img-wrapper">
                <img src="<%= firstImage %>" class="card-img-top property-image" alt="<%= item.title %>" loading="lazy">
                <div class="image-overlay-gradient"></div>
              </div>
            </a>

            <!-- DETAILS -->
            <div class="card-body p-3 d-flex flex-column">
              
              <div class="d-flex justify-content-between align-items-baseline mb-1">
                <h6 class="card-title fw-bold text-truncate mb-0" title="<%= item.title %>">
                  <a href="/listings/<%= item._id %>" class="text-decoration-none text-reset"><%= item.title %></a>
                </h6>
                <div class="rating-badge small fw-bold d-flex align-items-center gap-1">
                  <i class="fa-solid fa-star text-warning"></i>
                  <span><%= avgRate %></span>
                </div>
              </div>

              <p class="text-muted small text-truncate mb-2">
                <i class="fa-solid fa-location-dot text-danger opacity-75 me-1"></i><%= item.location %>, <%= item.country %>
              </p>

              <!-- PRICE BREAKDOWN (WITH TAX TOGGLE SUPPORT) -->
              <div class="mt-auto pt-2 border-top d-flex justify-content-between align-items-center">
                <div>
                  <div class="price-display base-price">
                    <span class="fs-5 fw-bold text-dark">₹ <%= item.price.toLocaleString("en-IN") %></span>
                    <span class="text-muted small"> / night</span>
                  </div>
                  <div class="price-display tax-price d-none">
                    <span class="fs-5 fw-bold text-danger">₹ <%= priceWithTax.toLocaleString("en-IN") %></span>
                    <span class="text-muted small"> / night (inc. 18% GST)</span>
                  </div>
                </div>

                <a href="/listings/<%= item._id %>" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                  View
                </a>
              </div>

            </div>

          </div>
        </div>

      <% } %>
    </div>

  <% } %>

</div>

<!-- Pass GeoJSON data for Leaflet Map -->
<script>
  window.listingMarkers = <%- JSON.stringify(listing.map(l => ({
    id: l._id,
    title: l.title,
    price: l.price,
    location: l.location,
    country: l.country,
    category: l.category,
    image: (l.images && l.images.length > 0) ? l.images[0].url : 'https://images.unsplash.com/photo-1566073771259-6a8506099945',
    lat: (l.geometry && l.geometry.lat) ? l.geometry.lat : 18.5204,
    lng: (l.geometry && l.geometry.lng) ? l.geometry.lng : 73.8567
  }))) %>;
</script>

<script src="/js/map.js"></script>