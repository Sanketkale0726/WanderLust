<% layout("/layouts/boilerplate") %>

<div class="container py-5">
  <div class="row justify-content-center text-center py-5">
    <div class="col-12 col-md-8 col-lg-6">
      
      <div class="card border-0 shadow-lg rounded-4 p-5">
        <div class="mb-4">
          <span class="display-1 fw-bold text-danger"><%= statusCode || 500 %></span>
        </div>

        <h3 class="fw-bold mb-2">Something went off track!</h3>
        <p class="text-secondary mb-4"><%= message || "We couldn't complete your request." %></p>

        <% if (typeof err !== 'undefined' && err && err.stack) { %>
          <div class="text-start bg-light p-3 rounded-3 mb-4 overflow-auto" style="max-height: 200px;">
            <pre class="small text-danger mb-0"><code><%= err.stack %></code></pre>
          </div>
        <% } %>

        <div class="d-flex justify-content-center gap-3">
          <a href="/listings" class="btn btn-danger rounded-pill px-4 py-2 fw-semibold">
            <i class="fa-solid fa-house me-2"></i> Return Home
          </a>
          <button onclick="history.back()" class="btn btn-outline-dark rounded-pill px-4 py-2 fw-semibold">
            Go Back
          </button>
        </div>
      </div>

    </div>
  </div>
</div>