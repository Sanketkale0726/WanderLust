<% layout("/layouts/boilerplate") %>

<% 
  const isWishlisted = (userWishlist && userWishlist.includes(detailList._id.toString()));
  const isOwner = (currentUser && detailList.owner && (currentUser.role === 'admin' || (detailList.owner._id && detailList.owner._id.toString() === currentUser._id.toString()) || detailList.owner.toString() === currentUser._id.toString()));
%>

<div class="container py-4">

  <!-- TOP HEADER: Title, Location, Action buttons -->
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2 mb-3">
    <div>
      <h2 class="fw-bold property-show-title mb-1"><%= detailList.title %></h2>
      <div class="d-flex flex-wrap align-items-center gap-3 small text-muted">
        <span class="fw-semibold text-dark">
          <i class="fa-solid fa-star text-warning"></i> <%= avgRating > 0 ? avgRating : 'New' %>
          (<%= detailList.reviews ? detailList.reviews.length : 0 %> reviews)
        </span>
        <span>·</span>
        <span class="badge bg-danger-subtle text-danger text-capitalize"><%= detailList.category || 'Luxury Stay' %></span>
        <span>·</span>
        <span><i class="fa-solid fa-location-dot text-danger me-1"></i> <%= detailList.location %>, <%= detailList.country %></span>
      </div>
    </div>

    <!-- WISHLIST & SHARE BUTTONS -->
    <div class="d-flex align-items-center gap-2">
      <button class="btn btn-outline-secondary btn-sm rounded-pill px-3 wishlist-heart-btn-show <%= isWishlisted ? 'favorited' : '' %>"
              data-listing-id="<%= detailList._id %>">
        <i class="<%= isWishlisted ? 'fa-solid fa-heart text-danger' : 'fa-regular fa-heart' %> me-1"></i>
        <span class="wishlist-btn-text"><%= isWishlisted ? 'Saved' : 'Save' %></span>
      </button>
      
      <button class="btn btn-outline-secondary btn-sm rounded-pill px-3" onclick="navigator.clipboard.writeText(window.location.href); alert('Link copied to clipboard!');">
        <i class="fa-solid fa-share-nodes me-1"></i> Share
      </button>
    </div>
  </div>

  <!-- 🖼️ LUXURY AIRBNB PHOTO GALLERY -->
  <div class="gallery-container mb-5 rounded-4 overflow-hidden shadow-sm">
    <div class="row g-2">
      <% if (detailList.images && detailList.images.length > 0) { %>
        
        <!-- MAIN LARGE HERO IMAGE -->
        <div class="col-12 <%= detailList.images.length > 1 ? 'col-md-7' : 'col-md-12' %>">
          <div class="gallery-hero-wrapper">
            <img src="<%= detailList.images[0].url %>" class="gallery-hero-img" alt="<%= detailList.title %>">
          </div>
        </div>

        <!-- THUMBNAILS GRID (IF MULTIPLE) -->
        <% if (detailList.images.length > 1) { %>
          <div class="col-12 col-md-5">
            <div class="row g-2">
              <% for(let i = 1; i < Math.min(detailList.images.length, 5); i++) { %>
                <div class="col-6">
                  <div class="gallery-thumb-wrapper">
                    <img src="<%= detailList.images[i].url %>" class="gallery-thumb-img" alt="Gallery photo <%= i %>">
                  </div>
                </div>
              <% } %>
            </div>
          </div>
        <% } %>

      <% } else { %>
        <div class="col-12">
          <div class="gallery-hero-wrapper">
            <img src="https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=1200&q=80" class="gallery-hero-img" alt="Default Stay">
          </div>
        </div>
      <% } %>
    </div>
  </div>

  <!-- MAIN BODY LAYOUT: Left Details & Right Booking Card -->
  <div class="row g-5">

    <!-- LEFT COLUMN: PROPERTY SPECS, HIGHLIGHTS, AMENITIES, REVIEWS -->
    <div class="col-12 col-lg-7">

      <!-- HOST HEADER & KEY STATS -->
      <div class="d-flex justify-content-between align-items-center pb-4 border-bottom">
        <div>
          <h4 class="fw-bold mb-1">
            Entire <%= detailList.category || 'stay' %> hosted by <%= detailList.owner ? detailList.owner.username : 'Wanderlust Host' %>
          </h4>
          <p class="text-muted mb-0">
            <%= detailList.maxGuests || 2 %> guests · <%= detailList.bedrooms || 1 %> bedroom · <%= detailList.beds || 1 %> bed · <%= detailList.bathrooms || 1 %> bathroom
          </p>
        </div>
        <div class="host-avatar-lg">
          <img src="<%= (detailList.owner && detailList.owner.avatar && detailList.owner.avatar.url) ? detailList.owner.avatar.url : 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=120&q=80' %>" 
               alt="Host avatar" class="rounded-circle shadow-sm" style="width: 58px; height: 58px; object-fit: cover;">
        </div>
      </div>

      <!-- KEY FEATURES HIGHLIGHTS -->
      <div class="py-4 border-bottom">
        <div class="d-flex align-items-start gap-3 mb-3">
          <i class="fa-solid fa-medal fs-4 text-danger mt-1"></i>
          <div>
            <h6 class="fw-bold mb-0">Experienced Host</h6>
            <small class="text-muted">Top-rated host committed to providing outstanding stays for guests.</small>
          </div>
        </div>
        <div class="d-flex align-items-start gap-3 mb-3">
          <i class="fa-solid fa-key fs-4 text-danger mt-1"></i>
          <div>
            <h6 class="fw-bold mb-0">Great Check-in Experience</h6>
            <small class="text-muted">100% of recent guests gave the check-in process a 5-star rating.</small>
          </div>
        </div>
        <div class="d-flex align-items-start gap-3">
          <i class="fa-solid fa-calendar-check fs-4 text-danger mt-1"></i>
          <div>
            <h6 class="fw-bold mb-0">Free Cancellation for 48 Hours</h6>
            <small class="text-muted">Get a full refund if you change your plans up to 48 hours before check-in.</small>
          </div>
        </div>
      </div>

      <!-- AIRCOVER PROTECTION BADGE -->
      <div class="py-4 border-bottom aircover-banner p-3 rounded-4 bg-light my-3">
        <h5 class="fw-bolder text-danger mb-1">
          <span class="text-dark">air</span>cover
        </h5>
        <p class="small text-muted mb-0">
          Every booking includes free protection from Host cancellations, listing inaccuracies, and other issues like trouble checking in.
        </p>
      </div>

      <!-- DESCRIPTION -->
      <div class="py-4 border-bottom">
        <h5 class="fw-bold mb-3">About this place</h5>
        <p class="property-description text-secondary leading-relaxed" style="white-space: pre-line;">
          <%= detailList.description %>
        </p>
      </div>

      <!-- 🌟 AI TRAVEL ASSISTANT & STAY HIGHLIGHTS (ADVANCED TECH) -->
      <div class="py-4 border-bottom">
        <div class="ai-assistant-card p-4 rounded-4 shadow-sm border">
          <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
            <div class="d-flex align-items-center gap-2">
              <span class="badge bg-gradient-danger p-2 rounded-circle"><i class="fa-solid fa-wand-magic-sparkles text-white"></i></span>
              <h5 class="fw-bold mb-0">AI Stay & Travel Insights</h5>
            </div>
            <button class="btn btn-sm btn-outline-danger rounded-pill px-3" id="generateAiInsightsBtn" data-listing-id="<%= detailList._id %>">
              <i class="fa-solid fa-sparkles me-1"></i> Generate Guide
            </button>
          </div>
          <div id="aiInsightsContent">
            <p class="text-muted small mb-0">
              Click <strong>Generate Guide</strong> to unlock instant AI curated neighborhood vibes, seasonal weather tips, and packing recommendations for <%= detailList.location %>!
            </p>
          </div>
        </div>
      </div>

      <!-- AMENITIES -->
      <div class="py-4 border-bottom">
        <h5 class="fw-bold mb-3">What this place offers</h5>
        <% if (detailList.amenities && detailList.amenities.length > 0) { %>
          <div class="row row-cols-1 row-cols-sm-2 g-3">
            <% for(let a of detailList.amenities) { %>
              <div class="col d-flex align-items-center gap-2 text-dark">
                <i class="fa-solid fa-check text-success fs-6"></i>
                <span class="fw-medium"><%= a %></span>
              </div>
            <% } %>
          </div>
        <% } else { %>
          <p class="text-muted">Standard luxury amenities (High-speed Wi-Fi, Air Conditioning, Hot Water, Dedicated Workspace) provided.</p>
        <% } %>
      </div>

      <!-- 🗺️ INTERACTIVE LEAFLET PROPERTY MAP -->
      <div class="py-4 border-bottom">
        <h5 class="fw-bold mb-2">Where you'll be</h5>
        <p class="text-muted small mb-3">
          <i class="fa-solid fa-map-pin text-danger me-1"></i> <%= detailList.address || detailList.location %>, <%= detailList.country %>
        </p>
        <div class="rounded-4 overflow-hidden shadow-sm border" style="height: 350px;" id="showMap"></div>
        <div class="mt-2 text-end">
          <a href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(detailList.title + ' ' + detailList.location) %>" target="_blank" class="small text-decoration-none text-danger fw-semibold">
            <i class="fa-solid fa-arrow-up-right-from-square me-1"></i> Open in Google Maps
          </a>
        </div>
      </div>

      <!-- OWNER ACTION BUTTONS (EDIT / DELETE) -->
      <% if (isOwner) { %>
        <div class="py-4 border-bottom bg-light p-3 rounded-4 my-3">
          <h6 class="fw-bold text-dark mb-2">Host Settings</h6>
          <div class="d-flex gap-2">
            <a href="/listings/<%= detailList._id %>/edit" class="btn btn-warning rounded-pill px-4">
              <i class="fa-solid fa-pen-to-square me-1"></i> Edit Listing
            </a>
            <form action="/listings/<%= detailList._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Are you sure you want to delete this listing permanently?');">
              <button class="btn btn-outline-danger rounded-pill px-4">
                <i class="fa-solid fa-trash me-1"></i> Delete Listing
              </button>
            </form>
          </div>
        </div>
      <% } %>

      <!-- ⭐ REVIEWS SECTION -->
      <div class="py-4">
        
        <div class="d-flex align-items-center gap-2 mb-4">
          <h4 class="fw-bold mb-0">
            <i class="fa-solid fa-star text-warning"></i> <%= avgRating > 0 ? avgRating : 'New' %>
          </h4>
          <span class="text-muted">· <%= detailList.reviews ? detailList.reviews.length : 0 %> reviews</span>
        </div>

        <!-- POST A REVIEW FORM (Logged in guests) -->
        <% if (currentUser && !isOwner) { %>
          <div class="card p-4 rounded-4 shadow-sm border-0 bg-light mb-4">
            <h5 class="fw-bold mb-3">Leave a Review</h5>
            <form action="/listings/<%= detailList._id %>/reviews" method="POST" class="needs-validation" novalidate>
              
              <!-- RATING PICKER -->
              <div class="mb-3">
                <label class="form-label fw-semibold small">Rating</label>
                <div class="star-rating-select d-flex gap-2 align-items-center">
                  <select name="review[rating]" class="form-select form-select-sm w-auto rounded-pill" required>
                    <option value="5" selected>⭐⭐⭐⭐⭐ (5 - Exceptional)</option>
                    <option value="4">⭐⭐⭐⭐ (4 - Very Good)</option>
                    <option value="3">⭐⭐⭐ (3 - Average)</option>
                    <option value="2">⭐⭐ (2 - Poor)</option>
                    <option value="1">⭐ (1 - Terrible)</option>
                  </select>
                </div>
              </div>

              <!-- COMMENT -->
              <div class="mb-3">
                <label class="form-label fw-semibold small">Your Experience</label>
                <textarea name="review[comment]" class="form-control rounded-3" rows="3" placeholder="How was your stay? Mention highlights, cleanliness, or location perks..." required></textarea>
                <div class="invalid-feedback">Please share a few words about your experience.</div>
              </div>

              <button type="submit" class="btn btn-danger rounded-pill px-4 fw-semibold">
                Submit Review
              </button>
            </form>
          </div>
        <% } %>

        <!-- ALL REVIEWS LIST -->
        <% if (!detailList.reviews || detailList.reviews.length === 0) { %>
          <div class="text-center py-4 bg-light rounded-4">
            <p class="text-muted mb-0">No reviews yet. Be the first traveler to leave a review for this wonderful stay!</p>
          </div>
        <% } else { %>
          <div class="row row-cols-1 row-cols-md-2 g-3">
            <% for(let r of detailList.reviews) { %>
              <div class="col">
                <div class="card p-3 h-100 rounded-4 shadow-sm border-0 bg-white">
                  
                  <div class="d-flex justify-content-between align-items-center mb-2">
                    <div class="d-flex align-items-center gap-2">
                      <div class="user-avatar-mini">
                        <i class="fa-solid fa-user"></i>
                      </div>
                      <div>
                        <h6 class="fw-bold mb-0"><%= (r.author && r.author.username) ? r.author.username : 'Traveler' %></h6>
                        <small class="text-muted"><%= new Date(r.createdAt || Date.now()).toLocaleDateString("en-IN", { month: 'short', year: 'numeric' }) %></small>
                      </div>
                    </div>
                    <div class="badge bg-warning-subtle text-dark">
                      ⭐ <%= r.rating %>/5
                    </div>
                  </div>

                  <p class="card-text text-secondary small mb-2"><%= r.comment %></p>

                  <!-- DELETE REVIEW BUTTON -->
                  <% if (currentUser && ((r.author && r.author._id && r.author._id.toString() === currentUser._id.toString()) || currentUser.role === 'admin')) { %>
                    <div class="mt-auto text-end">
                      <form action="/listings/<%= detailList._id %>/reviews/<%= r._id %>?_method=DELETE" method="POST">
                        <button class="btn btn-link text-danger text-decoration-none btn-sm p-0">
                          <i class="fa-solid fa-trash-can"></i> Delete
                        </button>
                      </form>
                    </div>
                  <% } %>

                </div>
              </div>
            <% } %>
          </div>
        <% } %>

      </div>

    </div>

    <!-- RIGHT COLUMN: REAL-TIME INTERACTIVE BOOKING & PRICE CALCULATOR CARD -->
    <div class="col-12 col-lg-5">
      <div class="sticky-top booking-card-wrapper" style="top: 100px;">
        
        <div class="card booking-widget-card shadow-lg border-0 rounded-4 p-4">
          
          <!-- PRICE HEADER -->
          <div class="d-flex justify-content-between align-items-baseline mb-3">
            <div>
              <span class="fs-3 fw-bolder text-dark">₹ <%= detailList.price.toLocaleString("en-IN") %></span>
              <span class="text-muted"> / night</span>
            </div>
            <div class="small fw-bold">
              <i class="fa-solid fa-star text-warning"></i> <%= avgRating > 0 ? avgRating : 'New' %>
            </div>
          </div>

          <!-- BOOKING FORM -->
          <form action="/listings/<%= detailList._id %>/book" method="POST" id="bookingForm" class="needs-validation" novalidate>
            
            <div class="booking-inputs-box border rounded-3 p-2 mb-3">
              
              <!-- DATES ROW -->
              <div class="row g-2 mb-2">
                <div class="col-6">
                  <label class="form-label text-uppercase fw-bold text-muted fs-xxs mb-1">Check-in</label>
                  <input type="date" name="checkIn" id="checkInDate" class="form-control form-control-sm border-0 p-0 fw-semibold" required>
                </div>
                <div class="col-6 border-start ps-2">
                  <label class="form-label text-uppercase fw-bold text-muted fs-xxs mb-1">Checkout</label>
                  <input type="date" name="checkOut" id="checkOutDate" class="form-control form-control-sm border-0 p-0 fw-semibold" required>
                </div>
              </div>

              <hr class="m-1">

              <!-- GUESTS SELECT -->
              <div class="pt-1">
                <label class="form-label text-uppercase fw-bold text-muted fs-xxs mb-1">Guests</label>
                <select name="guests" id="guestsCountSelect" class="form-select form-select-sm border-0 p-0 fw-semibold">
                  <% for(let g = 1; g <= (detailList.maxGuests || 5); g++) { %>
                    <option value="<%= g %>"><%= g %> <%= g === 1 ? 'guest' : 'guests' %></option>
                  <% } %>
                </select>
              </div>

            </div>

            <!-- SPECIAL REQUESTS (OPTIONAL) -->
            <div class="mb-3">
              <input type="text" name="specialRequests" class="form-control form-control-sm rounded-3" placeholder="Special requests (e.g. late check-in)...">
            </div>

            <!-- SUBMIT / RESERVE BUTTON -->
            <% if (!currentUser) { %>
              <a href="/login" class="btn btn-danger w-100 py-3 rounded-pill fw-bold fs-6 shadow-sm">
                Log in to Reserve
              </a>
            <% } else { %>
              <button type="submit" class="btn btn-gradient-danger w-100 py-3 rounded-pill fw-bold fs-6 shadow-sm">
                Reserve Stay
              </button>
            <% } %>

            <p class="text-center text-muted small mt-2 mb-3">You won't be charged yet</p>

            <!-- 💰 LIVE PRICE ESTIMATOR BREAKDOWN (DYNAMIC DOM UPDATE) -->
            <div class="price-calculator-breakdown" id="priceBreakdown">
              
              <div class="d-flex justify-content-between small text-muted mb-2">
                <span id="nightlyCalcText">₹ <%= detailList.price.toLocaleString("en-IN") %> × 1 night</span>
                <span id="basePriceTotal">₹ <%= detailList.price.toLocaleString("en-IN") %></span>
              </div>

              <div class="d-flex justify-content-between small text-muted mb-2">
                <span>Cleaning fee</span>
                <span>₹ <%= (detailList.cleaningFee || 499).toLocaleString("en-IN") %></span>
              </div>

              <div class="d-flex justify-content-between small text-muted mb-2">
                <span>Wanderlust service fee</span>
                <span>₹ <%= (detailList.serviceFee || 299).toLocaleString("en-IN") %></span>
              </div>

              <div class="d-flex justify-content-between small text-muted mb-2">
                <span>Taxes & GST (18%)</span>
                <span id="taxTotal">₹ <%= Math.round((detailList.price + (detailList.cleaningFee || 499) + (detailList.serviceFee || 299)) * 0.18).toLocaleString("en-IN") %></span>
              </div>

              <hr>

              <div class="d-flex justify-content-between fs-5 fw-bold text-dark">
                <span>Total before taxes</span>
                <span id="finalTotalText">₹ <%= ((detailList.price + (detailList.cleaningFee || 499) + (detailList.serviceFee || 299)) * 1.18).toFixed(0).toLocaleString("en-IN") %></span>
              </div>

            </div>

          </form>

        </div>

      </div>
    </div>

  </div>

</div>

<!-- Data for Map & Price Calc -->
<script>
  window.currentListing = {
    id: "<%= detailList._id %>",
    title: "<%= detailList.title %>",
    price: <%= detailList.price %>,
    cleaningFee: <%= detailList.cleaningFee || 499 %>,
    serviceFee: <%= detailList.serviceFee || 299 %>,
    lat: <%= (detailList.geometry && detailList.geometry.lat) ? detailList.geometry.lat : 18.5204 %>,
    lng: <%= (detailList.geometry && detailList.geometry.lng) ? detailList.geometry.lng : 73.8567 %>
  };
</script>

<script src="/js/priceCalc.js"></script>
<script src="/js/map.js"></script>