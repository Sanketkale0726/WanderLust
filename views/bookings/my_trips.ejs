<% layout("/layouts/boilerplate") %>

<div class="container py-5">
  
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4 border-bottom pb-3">
    <div>
      <h2 class="fw-bold mb-1">My Trips & Reservations</h2>
      <p class="text-muted small mb-0">View all your upcoming vacations, past stays, and download official receipts.</p>
    </div>
    <a href="/listings" class="btn btn-outline-danger rounded-pill px-4">
      <i class="fa-solid fa-magnifying-glass me-1"></i> Explore More Stays
    </a>
  </div>

  <% if (!bookings || bookings.length === 0) { %>
    <div class="text-center py-5 empty-state-box my-4 rounded-4 shadow-sm">
      <i class="fa-solid fa-plane-departure fa-3x text-muted mb-3"></i>
      <h4 class="fw-bold">No trips booked... yet!</h4>
      <p class="text-muted">Time to dust off your bags and start planning your next great adventure.</p>
      <a href="/listings" class="btn btn-danger rounded-pill px-5 py-2 mt-2 fw-semibold">Start Searching</a>
    </div>
  <% } else { %>
    
    <div class="row g-4">
      <% for(let b of bookings) { %>
        <% if (b.listing) { %>
          <% 
            const checkInFormatted = new Date(b.checkIn).toLocaleDateString("en-IN", { month: 'short', day: 'numeric', year: 'numeric' });
            const checkOutFormatted = new Date(b.checkOut).toLocaleDateString("en-IN", { month: 'short', day: 'numeric', year: 'numeric' });
            const isPast = new Date(b.checkOut) < new Date();
            const photo = (b.listing.images && b.listing.images.length > 0) ? b.listing.images[0].url : 'https://images.unsplash.com/photo-1566073771259-6a8506099945';
          %>

          <div class="col-12 col-lg-6">
            <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden trip-booking-card">
              
              <div class="row g-0 h-100">
                <!-- IMAGE -->
                <div class="col-sm-5 position-relative">
                  <img src="<%= photo %>" class="w-100 h-100 object-fit-cover trip-card-img" alt="<%= b.listing.title %>">
                  <span class="badge position-absolute top-0 start-0 m-2 rounded-pill <%= b.status === 'cancelled' ? 'bg-danger' : (isPast ? 'bg-secondary' : 'bg-success') %>">
                    <%= b.status === 'cancelled' ? 'Cancelled' : (isPast ? 'Completed' : 'Confirmed') %>
                  </span>
                </div>

                <!-- DETAILS -->
                <div class="col-sm-7 p-3 p-md-4 d-flex flex-column justify-content-between">
                  <div>
                    <div class="d-flex justify-content-between align-items-start mb-1">
                      <span class="badge bg-danger-subtle text-danger text-capitalize fs-xxs"><%= b.listing.category || 'Stay' %></span>
                      <small class="text-muted fw-bold">#<%= b._id.toString().slice(-6).toUpperCase() %></small>
                    </div>

                    <h5 class="fw-bold mb-1 text-truncate">
                      <a href="/listings/<%= b.listing._id %>" class="text-dark text-decoration-none"><%= b.listing.title %></a>
                    </h5>
                    <p class="text-muted small mb-2">
                      <i class="fa-solid fa-location-dot text-danger me-1"></i> <%= b.listing.location %>, <%= b.listing.country %>
                    </p>

                    <div class="bg-light p-2 rounded-3 small mb-3">
                      <div><strong>Dates:</strong> <%= checkInFormatted %> – <%= checkOutFormatted %></div>
                      <div><strong>Guests:</strong> <%= b.guests %> · <%= b.nights %> Night<%= b.nights > 1 ? 's' : '' %></div>
                      <div class="text-danger fw-bold mt-1">Total Paid: ₹ <%= b.totalPrice.toLocaleString("en-IN") %></div>
                    </div>
                  </div>

                  <!-- ACTIONS -->
                  <div class="d-flex gap-2">
                    <button class="btn btn-outline-dark btn-sm rounded-pill flex-grow-1" onclick="window.print()">
                      <i class="fa-solid fa-receipt me-1"></i> Receipt
                    </button>

                    <% if (b.status === 'confirmed' && !isPast) { %>
                      <form action="/bookings/<%= b._id %>/cancel" method="POST" onsubmit="return confirm('Are you sure you want to cancel this booking? A refund will be initiated.');" class="flex-grow-1">
                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill w-100">
                          Cancel
                        </button>
                      </form>
                    <% } %>
                  </div>

                </div>

              </div>

            </div>
          </div>

        <% } %>
      <% } %>
    </div>

  <% } %>

</div>
