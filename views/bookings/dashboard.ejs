<% layout("/layouts/boilerplate") %>

<div class="container py-5">
  
  <!-- HOST HEADER -->
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4 pb-3 border-bottom">
    <div>
      <div class="badge bg-danger-subtle text-danger text-uppercase px-3 py-1 rounded-pill fw-bold mb-1">Host Analytics</div>
      <h2 class="fw-bold mb-0">Host Control Dashboard</h2>
      <p class="text-muted small mb-0">Monitor your property earnings, guest reservations, and booking statuses.</p>
    </div>
    <div class="d-flex gap-2">
      <a href="/listings/new" class="btn btn-danger rounded-pill px-4">
        <i class="fa-solid fa-plus me-1"></i> Add New Stay
      </a>
    </div>
  </div>

  <!-- METRIC CARDS -->
  <div class="row g-4 mb-5">
    
    <div class="col-12 col-sm-6 col-lg-3">
      <div class="card p-4 rounded-4 shadow-sm border-0 bg-light text-dark h-100">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <span class="text-muted small fw-bold text-uppercase">Total Revenue</span>
          <div class="p-2 rounded-circle bg-success-subtle text-success"><i class="fa-solid fa-indian-rupee-sign"></i></div>
        </div>
        <h3 class="fw-bold text-success mb-0">₹ <%= totalEarnings.toLocaleString("en-IN") %></h3>
        <small class="text-muted mt-2">Gross booking payouts</small>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-lg-3">
      <div class="card p-4 rounded-4 shadow-sm border-0 bg-light text-dark h-100">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <span class="text-muted small fw-bold text-uppercase">Total Bookings</span>
          <div class="p-2 rounded-circle bg-primary-subtle text-primary"><i class="fa-solid fa-suitcase-rolling"></i></div>
        </div>
        <h3 class="fw-bold mb-0"><%= totalReservations %></h3>
        <small class="text-muted mt-2">All time guest reservations</small>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-lg-3">
      <div class="card p-4 rounded-4 shadow-sm border-0 bg-light text-dark h-100">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <span class="text-muted small fw-bold text-uppercase">Active Stays</span>
          <div class="p-2 rounded-circle bg-warning-subtle text-warning"><i class="fa-solid fa-key"></i></div>
        </div>
        <h3 class="fw-bold mb-0"><%= activeReservations %></h3>
        <small class="text-muted mt-2">Current & upcoming guests</small>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-lg-3">
      <div class="card p-4 rounded-4 shadow-sm border-0 bg-light text-dark h-100">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <span class="text-muted small fw-bold text-uppercase">My Properties</span>
          <div class="p-2 rounded-circle bg-danger-subtle text-danger"><i class="fa-solid fa-house"></i></div>
        </div>
        <h3 class="fw-bold mb-0"><%= myListings.length %></h3>
        <small class="text-muted mt-2">Active published listings</small>
      </div>
    </div>

  </div>

  <!-- RESERVATIONS TABLE -->
  <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-5">
    <div class="card-header bg-white p-4 border-bottom d-flex justify-content-between align-items-center">
      <h5 class="fw-bold mb-0">Guest Reservations</h5>
      <span class="badge bg-dark rounded-pill px-3 py-2"><%= hostBookings.length %> Bookings</span>
    </div>
    
    <% if (hostBookings.length === 0) { %>
      <div class="text-center py-5">
        <i class="fa-solid fa-calendar-xmark fa-2x text-muted mb-2"></i>
        <p class="text-muted mb-0">No guest bookings recorded yet for your properties.</p>
      </div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th class="ps-4">Property</th>
              <th>Guest</th>
              <th>Check-in / Check-out</th>
              <th>Payout</th>
              <th>Status</th>
              <th class="text-end pe-4">Action</th>
            </tr>
          </thead>
          <tbody>
            <% for(let b of hostBookings) { %>
              <tr>
                <td class="ps-4">
                  <div class="fw-bold text-dark"><%= b.listing ? b.listing.title : 'Deleted listing' %></div>
                  <small class="text-muted">#<%= b._id.toString().slice(-6).toUpperCase() %></small>
                </td>
                <td>
                  <div class="fw-semibold"><%= b.user ? b.user.username : 'Guest' %></div>
                  <small class="text-muted"><%= b.user ? b.user.email : 'N/A' %></small>
                </td>
                <td>
                  <div><%= new Date(b.checkIn).toLocaleDateString("en-IN", { month: 'short', day: 'numeric' }) %> → <%= new Date(b.checkOut).toLocaleDateString("en-IN", { month: 'short', day: 'numeric' }) %></div>
                  <small class="text-muted"><%= b.nights %> Night<%= b.nights > 1 ? 's' : '' %> · <%= b.guests %> Guest<%= b.guests > 1 ? 's' : '' %></small>
                </td>
                <td>
                  <span class="fw-bold text-success">₹ <%= b.totalPrice.toLocaleString("en-IN") %></span>
                </td>
                <td>
                  <span class="badge rounded-pill <%= b.status === 'confirmed' ? 'bg-success' : (b.status === 'cancelled' ? 'bg-danger' : 'bg-secondary') %> text-capitalize">
                    <%= b.status %>
                  </span>
                </td>
                <td class="text-end pe-4">
                  <form action="/bookings/<%= b._id %>/status?_method=PATCH" method="POST" class="d-inline-flex gap-1">
                    <select name="status" class="form-select form-select-sm w-auto rounded-pill" onchange="this.form.submit()">
                      <option value="confirmed" <%= b.status === 'confirmed' ? 'selected' : '' %>>Confirmed</option>
                      <option value="completed" <%= b.status === 'completed' ? 'selected' : '' %>>Completed</option>
                      <option value="cancelled" <%= b.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
                    </select>
                  </form>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

  <!-- MY LISTINGS LIST -->
  <div class="card shadow-sm border-0 rounded-4 p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h5 class="fw-bold mb-0">My Published Stays</h5>
      <a href="/listings/new" class="btn btn-outline-dark btn-sm rounded-pill px-3">Add Another</a>
    </div>

    <div class="row row-cols-1 row-cols-md-3 g-3">
      <% for(let l of myListings) { %>
        <div class="col">
          <div class="card h-100 rounded-3 border p-2">
            <div class="d-flex gap-3">
              <img src="<%= (l.images && l.images.length > 0) ? l.images[0].url : 'https://images.unsplash.com/photo-1566073771259-6a8506099945' %>" class="rounded-2" style="width: 70px; height: 60px; object-fit: cover;">
              <div class="flex-grow-1 overflow-hidden">
                <h6 class="fw-bold text-truncate mb-0"><%= l.title %></h6>
                <small class="text-muted"><%= l.location %> · ₹ <%= l.price %> / night</small>
                <div class="mt-2 d-flex gap-2">
                  <a href="/listings/<%= l._id %>" class="btn btn-sm btn-outline-dark py-0 px-2 fs-xxs rounded">View</a>
                  <a href="/listings/<%= l._id %>/edit" class="btn btn-sm btn-warning py-0 px-2 fs-xxs rounded">Edit</a>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% } %>
    </div>
  </div>

</div>
